#!/usr/bin/expect -f
#
# Non-interactive wrapper around `pnpm exec drizzle-kit push` for CI.
#
# drizzle-kit's prompt library (clack-style) reads real keystrokes from
# the TTY and ignores piped character streams, so a plain `yes No | ...`
# will hang: the arrow-key UI stays open and GitHub kills the step for
# output-silence after ~15s.
#
# This script spawns drizzle-kit under a PTY (expect's `spawn` always
# does that) and reacts to the specific prompts drizzle-kit emits:
#
#   - "truncate ... table?" with the "No" option pre-selected — the
#     prompt that currently blocks prod. We send ENTER to confirm the
#     default, i.e. "don't truncate, try the ADD CONSTRAINT and let the
#     DB raise an error if duplicates exist". NEVER sends "Yes" because
#     that would wipe data silently.
#
#   - "data-loss ... Yes/No" — any future prompt matching this shape is
#     also handled by picking the SAFE option. If an unknown prompt
#     appears we deliberately time out instead of guessing.
#
# The script forwards drizzle-kit's exit code so the CI step fails
# correctly when the DB rejects a statement.

set timeout 300
log_user 1
spawn -noecho pnpm exec drizzle-kit push

expect {
    # Stage 1: "add unique constraint … Do you want to truncate …?"
    # Default (pre-selected) is "No, add the constraint without truncating".
    # Send ENTER to accept — preserves data; the DB raises an error if
    # duplicates exist, which is the behaviour we want.
    -re "Do you want to truncate" {
        send "\r"
        exp_continue
    }

    # Stage 2: FINAL apply confirmation that drizzle-kit prints AFTER the
    # full DDL plan is dumped. The options are:
    #
    #   ❯ No, abort
    #     Yes, I want to execute all statements
    #
    # Default is "No, abort" so a bare ENTER would abort the whole push
    # (that's what blocked the previous run — "[x] All changes were
    # aborted"). We send Down-Arrow + ENTER to pick "Yes, execute all
    # statements". Match on the UNIQUE phrase so this never collides with
    # the truncate prompt above.
    -re "I want to execute all statements" {
        send "\033\[B\r"
        exp_continue
    }

    # Any other prompt shape — stop here rather than guessing. Explicitly
    # not matching "(Yes|No).+" broadly because arrow-key menus with a
    # SAFE default should be left as default (ENTER) and arrow-key menus
    # with a DESTRUCTIVE default must not be auto-advanced.
    timeout {
        send_user "\n[expect] timed out waiting for drizzle-kit output\n"
        exit 1
    }

    eof
}

catch wait result
# `wait` returns {pid spawnid os_error_flag exit_code}
exit [lindex $result 3]
